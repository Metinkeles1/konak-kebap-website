# Site — production canonical URL
NEXT_PUBLIC_SITE_URL=https://konakkebap.com

# Google Places API (gerçek/canlı Google yorumları için)
# Sadece API key gerekli — Place ID kodda gömülü (ChIJ4Vw_srbRyhQRwOvuGT0yxME).
# https://console.cloud.google.com/google/maps-apis → Places API'yi etkinleştir → API key oluştur
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
# Farklı bir işletme için Place ID'yi override etmek istersen:
# GOOGLE_PLACE_ID=YOUR_GOOGLE_PLACE_ID

# Microsoft Clarity (ücretsiz heatmap & session recording)
# https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_PROJECT_ID=YOUR_CLARITY_PROJECT_ID
